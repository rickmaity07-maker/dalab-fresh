# Copy to .env.local and fill in. Everything is optional for local development:
# without DATABASE_URL orders go to data/orders.json, without SMTP_* emails go to a test inbox,
# without Cloudinary products show illustrated tiles.

# Neon Postgres: console.neon.tech > your project > Connect > copy the pooled connection string
DATABASE_URL=

# Email (any SMTP provider). Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dalab Fresh <bestellung@your-domain.de>"
# Gets a copy of every order
STORE_EMAIL=

# Cloudinary: console.cloudinary.com > Settings > API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Any long random string; protects POST /api/revalidate
REVALIDATE_SECRET=

# Staff login for /admin (at least 8 characters)
ADMIN_PASSWORD=

# Optional: the public address, used in emails and share images (defaults to the Vercel domain)
NEXT_PUBLIC_SITE_URL=
